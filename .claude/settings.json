{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(tree:*)",
      "Bash(wc:*)",
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git checkout develop)",
      "Bash(git checkout -b:*)",
      "Bash(git pull origin develop)",
      "Bash(git fetch:*)",
      "Bash(git init:*)",
      "Bash(git remote:*)",
      "Bash(curl:*)",
      "Bash(sleep:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(tr:*)",
      "Bash(which:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin develop)",
      "Bash(git push -u origin develop)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npm uninstall:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx prettier:*)",
      "Bash(npx vercel:*)",
      "Bash(npx supabase:*)",
      "Bash(npx create-next-app:*)",
      "Bash(npx shadcn:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(curl -s --retry 15 --retry-delay 1 --retry-all-errors --retry-connrefused http://localhost:3000/ -o /tmp/home.html -w \"HTTP %{http_code}\\\\n\" 2>&1; echo \"--- トップページ 主要テキスト ---\"; grep -oE \"\\(LIFE IS COLORFUL|あなたの「好き」から|加盟店を探す|加盟店ピックアップ|エリアから探す\\)\" /tmp/home.html | sort -u; echo \"--- 加盟店一覧 ---\"; curl -s http://localhost:3000/stores -o /tmp/stores2.html -w \"HTTP %{http_code}\\\\n\"; grep -oE \"\\(北海道・東北|関東|九州・沖縄|ハウジング福島センター|名和建築\\)\" /tmp/stores2.html | sort -u; echo \"--- 加盟店詳細\\(名和建築\\) ---\"; curl -s http://localhost:3000/stores/nawa-kenchiku -o /tmp/t.html -w \"HTTP %{http_code}\\\\n\"; grep -oE \"\\(株式会社名和建築|施工事例|準備中|移行前の専用サイト\\)\" /tmp/t.html | sort -u)",
      "Read(//tmp/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(rm -rf /:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin master:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(chmod 777:*)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./.env.production)"
    ],
    "ask": [
      "Bash(npx:*)",
      "Bash(wget:*)",
      "WebFetch",
      "WebSearch"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/block-main-push.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "./.claude/hooks/scan-secrets.sh"
          },
          {
            "type": "command",
            "command": "./.claude/hooks/protect-foundation.sh"
          }
        ]
      }
    ]
  }
}
