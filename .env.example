# ============================================
# 環境変数（Environment Variables）
# ============================================
# このファイルは「どんな環境変数が必要か」を示すテンプレートです。
# 実際の値は入っていません。
#
# ⚠️ 重要：
#   - このファイルには本物のキーやパスワードを書かないでください
#   - 実際の値はエンジニアに設定してもらいます
#
# ローカル開発時：
#   このファイルを .env.local にコピーして値を入力してください。
#   cp .env.example .env.local
#
# 本番環境（Vercel）：
#   エンジニアがVercelの設定画面で値を設定します。
# ============================================

# サイトのURL（デプロイ後に設定）
# NEXT_PUBLIC_SITE_URL=https://example.com

# バックエンドAPI（必要な場合）
# API_BASE_URL=https://api.example.com
# API_KEY=your-api-key-here

# Supabase（データベースが必要な場合）
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# ※ SUPABASE_SERVICE_ROLE_KEY はサーバーサイドのみ。NEXT_PUBLIC_ を付けないこと。

# 認証（ログイン機能がある場合）
# NEXTAUTH_URL=https://example.com
# NEXTAUTH_SECRET=generate-a-random-secret-here

# データベース（必要な場合）
# DATABASE_URL=your-database-connection-string

# ============================================
# NEXT_PUBLIC_ で始まる変数はブラウザに露出します。
# 秘密情報には NEXT_PUBLIC_ を付けないでください。
# ============================================
